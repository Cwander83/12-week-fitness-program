---
import type { DayData, RestBlock } from '../../types/workout';

export interface Props {
  day: DayData;
  nextTrainingDay?: DayData | null;
}

const { day, nextTrainingDay } = Astro.props;
const restBlocks = day.blocks.filter((b): b is RestBlock => b.type === 'rest');
const isActive = day.restMode === 'active-recovery';
---

<section class="rest-panel" aria-labelledby="rest-heading">
  <div class="rest-card">
    <div class="rest-head">
      <h2 id="rest-heading" class="rest-title">
        {isActive ? 'Active Recovery Protocol' : 'Scheduled Full Rest'}
      </h2>
      <span class="badge badge-warmup">{isActive ? 'Active Cardio / Recovery' : 'Complete Recovery'}</span>
    </div>

    <ul class="rest-items tabular">
      {restBlocks.flatMap((b) => b.items).map((item) => (
        <li>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <polyline points="22 12 18 12 15 21 9 3 6 12 2 12" />
          </svg>
          <span>{item}</span>
        </li>
      ))}
    </ul>

    <p class="rest-copy">
      {isActive
        ? 'No resistance lifting prescribed today. Complete the scheduled low-impact cardio and twist work to support blood flow and glycogen turnover ahead of the next lifting session.'
        : 'Zero lifting or cardio prescribed today. Prioritize sleep, hydration, and full nervous system recovery before returning to the floor.'}
    </p>
  </div>

  {nextTrainingDay && (
    <div class="preview-card">
      <div>
        <h3 class="preview-title">Next Training Session — {nextTrainingDay.title}</h3>
        <div class="preview-label tabular">
          Week {nextTrainingDay.weekNumber} · Day {nextTrainingDay.dayNumber}
        </div>
        <div class="preview-muscles">
          Target: {nextTrainingDay.primaryMuscles.join(', ')}
          {nextTrainingDay.hasDtp ? ' · Includes DTP Protocol' : ''}
        </div>
      </div>
      <a href={`/day/${nextTrainingDay.dayNumber}`} class="btn-hit btn-outline tabular">
        <span>Preview Day {nextTrainingDay.dayNumber}</span>
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <line x1="5" y1="12" x2="19" y2="12" />
          <polyline points="12 5 19 12 12 19" />
        </svg>
      </a>
    </div>
  )}
</section>

<style>
  @layer components {
    .rest-panel {
      margin-block-start: 1rem;
      display: flex;
      flex-direction: column;
      gap: 0.875rem;
    }

    .rest-card {
      padding: 1rem;
      border: 1px solid var(--control-border);
      background-color: var(--surface);
    }

    .rest-head {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      justify-content: space-between;
      gap: 0.5rem;
      margin-block-end: 0.75rem;
    }

    .rest-title {
      margin: 0;
      font-size: 1.125rem;
      font-weight: 700;
      color: var(--ink);
    }

    .rest-items {
      list-style: none;
      margin: 0 0 0.75rem;
      padding: 0.625rem 0.75rem;
      border: 1px solid var(--rule);
      background-color: var(--band);
      display: flex;
      flex-direction: column;
      gap: 0.375rem;
      font-weight: 600;
      font-size: 0.9375rem;
    }

    .rest-items li {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
    }

    .rest-copy {
      margin: 0;
      font-size: 0.9375rem;
      color: var(--muted);
      max-inline-size: 65ch;
    }

    .preview-card {
      padding: 0.875rem 1rem;
      border: 1px solid var(--rule);
      background-color: var(--band);
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      justify-content: space-between;
      gap: 0.75rem;
    }

    .preview-label {
      font-size: 0.75rem;
      font-weight: 700;
      color: var(--vermilion-text);
      margin-block: 0.125rem 0.25rem;
    }

    .preview-title {
      margin: 0;
      font-size: 1.0625rem;
      font-weight: 700;
      color: var(--ink);
    }

    .preview-muscles {
      font-size: 0.8125rem;
      color: var(--muted);
      text-transform: capitalize;
    }
  }
</style>
