---
export interface Props {
  dayNumber: number;
  nextDay?: {
    dayNumber: number;
    title: string;
  } | null;
}

const { dayNumber, nextDay } = Astro.props;
---

<section class="complete-bar" data-complete-group aria-label="Whole-day completion tracking">
  <button
    type="button"
    class="btn-hit complete-toggle tabular"
    data-complete-day={dayNumber}
    aria-pressed="false"
  >
    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <rect x="3" y="3" width="18" height="18" rx="2" />
      <polyline class="check-stroke" points="8.5 12.5 11 15 16 9" />
    </svg>
    <span>Complete Day {dayNumber}</span>
  </button>

  <div class="complete-meta">
    <span class="complete-status tabular" data-complete-status role="status" aria-live="polite">
      0 / 84 Complete
    </span>
    {nextDay && (
      <a
        href={`/day/${nextDay.dayNumber}`}
        class="btn-hit btn-outline tabular up-next-btn"
        data-up-next-link
        hidden
      >
        <span>Up Next: Day {nextDay.dayNumber} — {nextDay.title}</span>
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <line x1="5" y1="12" x2="19" y2="12" />
          <polyline points="12 5 19 12 12 19" />
        </svg>
      </a>
    )}
  </div>
</section>

<style>
  @layer components {
    .check-stroke {
      opacity: 0;
    }

    .complete-toggle[aria-pressed='true'] .check-stroke {
      opacity: 1;
    }

    .complete-meta {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 0.5rem 0.75rem;
    }

    .up-next-btn[hidden] {
      display: none;
    }
  }
</style>
