---
import type { DtpBlock } from '../../types/workout';
import DtpPyramid from '../diagrams/DtpPyramid.astro';

export interface Props {
  block: DtpBlock;
}

const { block } = Astro.props;
const isSuperset = block.variant.includes('superset');
const isHalf = block.variant.includes('half-');

const hasUnifiedSupersetWave =
  isSuperset && (block.exercises[0]?.repWave.length ?? 0) > 0;

// Detect sequential split waves (e.g., Day 58 & Day 75: two 5-set exercises forming 10 sequential sets)
const isSequentialSplitWave =
  !isSuperset &&
  block.exercises.length === 2 &&
  block.exercises.every((ex) => ex.repWave.length > 0);

interface TableRow {
  setIndex: number;
  cols: string[];
  cadence: string;
  isPeak: boolean;
}

const tableRows: TableRow[] = [];
if (isSequentialSplitWave) {
  let setNum = 1;
  for (const ex of block.exercises) {
    ex.repWave.forEach((reps, i) => {
      const prev = i > 0 ? ex.repWave[i - 1]! : null;
      const isPeak = reps === 10;
      const cadence = isPeak
        ? 'Peak Heavy Load'
        : prev === null
          ? reps >= 40
            ? 'Opening Flush'
            : 'Add Weight'
          : reps < prev
            ? 'Add Weight'
            : 'Drop Weight';
      tableRows.push({
        setIndex: setNum++,
        cols: [ex.name, `${reps} reps`],
        cadence,
        isPeak,
      });
    });
  }
} else {
  const maxSets = Math.max(0, ...block.exercises.map((ex) => ex.repWave.length));
  const primaryWave = block.exercises.find((ex) => ex.repWave.length === maxSets)?.repWave ?? [];
  for (let i = 0; i < maxSets; i++) {
    const reps = primaryWave[i] ?? 0;
    const prev = i > 0 ? primaryWave[i - 1]! : null;
    const isPeak = reps === 10;
    const cadence = isPeak
      ? 'Peak Heavy Load'
      : prev === null
        ? reps >= 40
          ? 'Opening Flush'
          : 'Add Weight'
        : reps < prev
          ? 'Add Weight'
          : 'Drop Weight';
    const cols = block.exercises.map((ex) => {
      if (ex.repWave[i] !== undefined) {
        return `1 set of ${ex.repWave[i]} reps`;
      }
      if (ex.standardSets?.length) {
        return ex.standardSets.map((s) => `${s.reps} reps`).join(' · ');
      }
      return '—';
    });
    tableRows.push({
      setIndex: i + 1,
      cols,
      cadence,
      isPeak,
    });
  }
}

const totalWorkingSets = block.exercises.reduce((sum, ex) => {
  if (ex.repWave.length > 0) return sum + ex.repWave.length;
  if (ex.standardSets?.length) {
    return sum + ex.standardSets.reduce((acc, s) => acc + (s.sets ?? 1), 0);
  }
  return sum;
}, 0);
---

<section class="dtp-block">
  <div class="dtp-block-head">
    <h3 class="dtp-block-title">{block.label}</h3>
    <div class="dtp-badges">
      <span class="badge badge-dtp">{isHalf ? '1/2 DTP' : 'DTP'}</span>
      {isSuperset && <span class="badge badge-cobalt">Antagonistic Pair</span>}
    </div>
  </div>

  <div class:list={[{ 'bracket-rail': block.exercises.length > 1 || isSuperset, 'dtp-list': true }]}>
    {block.exercises.map((ex, i) => {
      const totalReps = ex.repWave.reduce((acc, r) => acc + r, 0);
      const badgeCode = isSuperset ? `A${i + 1}` : String(i + 1).padStart(2, '0');
      return (
        <div class="ex-card">
          <div class="ex-head">
            <div class="ex-title-group">
              <span class:list={['badge', isSuperset ? 'badge-cobalt-fill' : 'badge-dtp', 'tabular']}>
                {badgeCode}
              </span>
              <h4 class="dtp-ex-name">{ex.name}</h4>
            </div>
            {ex.repWave.length > 0 && (
              <span class="dtp-ex-meta tabular">
                {ex.repWave.length} Sets · {totalReps} Reps
              </span>
            )}
          </div>

          {ex.warmup && ex.warmup.length > 0 && (
            <div class="dtp-subline tabular">
              {ex.warmup.map((w) => (
                <div class="dtp-rx">
                  <span class="badge badge-warmup">Warm-Up</span>
                  <span>{w.rawText}</span>
                </div>
              ))}
            </div>
          )}

          {ex.repWave.length > 0 && (
            <p class="dtp-wave-text tabular">
              1 set each: {ex.repWave.join(' · ')} reps
            </p>
          )}

          {ex.standardSets && ex.standardSets.length > 0 && (
            <div class="dtp-subline tabular">
              {ex.standardSets.map((s) => (
                <div class="dtp-rx">
                  <span class="badge badge-working">Working</span>
                  <span class="dtp-rx-strong">{s.rawText}</span>
                </div>
              ))}
            </div>
          )}
        </div>
      );
    })}
  </div>

  <div class="dtp-pyramids">
    {hasUnifiedSupersetWave ? (
      <DtpPyramid repWave={block.exercises[0]!.repWave} label={block.label} />
    ) : (
      block.exercises
        .filter((ex) => ex.repWave.length > 0)
        .map((ex) => <DtpPyramid repWave={ex.repWave} label={ex.name} />)
    )}
  </div>

  {tableRows.length > 0 && (
    <details class="protocol-item dtp-disclosure">
      <summary>
        <span class="summary-left">
          <svg class="summary-chev" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <polyline points="9 18 15 12 9 6" />
          </svg>
          <span>Complete {tableRows.length}-Set Prescription Table (Sets 01–{String(tableRows.length).padStart(2, '0')})</span>
        </span>
        <span class="summary-meta tabular">{totalWorkingSets} Sets Total</span>
      </summary>
      <div class="table-scroll">
        <table class="dtp-table tabular">
          <thead>
            <tr>
              <th scope="col">Set</th>
              {isSequentialSplitWave ? (
                <>
                  <th scope="col">Movement</th>
                  <th scope="col">Target Reps</th>
                </>
              ) : (
                block.exercises.map((ex, i) => (
                  <th scope="col">{isSuperset ? `A${i + 1} ${ex.name}` : ex.name}</th>
                ))
              )}
              <th scope="col">Load Cadence</th>
            </tr>
          </thead>
          <tbody>
            {tableRows.map((row) => (
              <tr>
                <td class="cell-set">{String(row.setIndex).padStart(2, '0')}</td>
                {row.cols.map((col) => (
                  <td>{col}</td>
                ))}
                <td class:list={[{ 'cell-peak': row.isPeak }]}>{row.cadence}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </details>
  )}
</section>

<style>
  @layer components {
    .dtp-block {
      margin-block: 0.2rem;
    }

    .dtp-block-head {
      display: flex;
      flex-wrap: wrap;
      align-items: baseline;
      justify-content: space-between;
      gap: 0.25rem 0.75rem;
      margin-block-end: 0.25rem;
    }

    .dtp-block-title {
      margin: 0;
      font-size: 1rem;
      font-weight: 700;
      color: var(--ink);
    }

    .dtp-badges {
      display: flex;
      flex-wrap: wrap;
      gap: 0.375rem;
    }

    .dtp-list {
      display: flex;
      flex-direction: column;
      gap: 0.45rem;
    }

    .dtp-ex-name {
      margin: 0;
      font-size: 0.875rem;
      font-weight: 700;
      color: var(--ink);
    }

    @media (min-width: 48rem) {
      .dtp-ex-name {
        font-size: 0.9375rem;
      }
    }

    .dtp-ex-meta {
      font-size: 0.75rem;
      font-weight: 700;
      color: var(--muted);
      white-space: nowrap;
      flex-shrink: 0;
    }

    .dtp-wave-text {
      margin: 0.2rem 0 0;
      font-size: 0.8125rem;
      color: var(--muted);
    }

    .dtp-subline {
      margin-block-start: 0.3rem;
      display: flex;
      flex-direction: column;
      gap: 0.2rem;
    }

    .dtp-rx {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 0.45rem;
      font-size: 0.8125rem;
      color: var(--muted);
    }

    .dtp-rx-strong {
      color: var(--ink);
      font-weight: 600;
    }

    .badge-working {
      border: 1px solid var(--control-border);
      color: var(--ink);
      background-color: var(--band);
    }

    .dtp-pyramids {
      margin-block-start: 0.35rem;
      display: flex;
      flex-direction: column;
      gap: 0.5rem;
    }

    @media (min-width: 40rem) {
      .dtp-block {
        margin-block: 0.5rem;
      }

      .dtp-block-head {
        margin-block-end: 0.4rem;
      }

      .dtp-pyramids {
        margin-block-start: 0.5rem;
        gap: 0.65rem;
      }
    }

    .dtp-disclosure {
      margin-block-start: 0.5rem;
      border-top: 1px solid var(--rule);
    }

    .summary-meta {
      font-size: 0.75rem;
      font-weight: 600;
      color: var(--muted);
      white-space: nowrap;
      flex-shrink: 0;
    }

    .table-scroll {
      overflow-x: auto;
      padding-block-end: 0.75rem;
    }

    .dtp-table {
      width: 100%;
      border-collapse: collapse;
      text-align: left;
      font-size: 0.8125rem;
    }

    @media (min-width: 48rem) {
      .dtp-table {
        font-size: 0.875rem;
      }
    }

    .dtp-table th {
      padding: 0.45rem 0.75rem 0.45rem 0;
      border-bottom: 1px solid var(--control-border);
      color: var(--muted);
      font-weight: 700;
      font-size: 0.75rem;
      text-transform: uppercase;
      letter-spacing: 0.03em;
    }

    .dtp-table td {
      padding: 0.45rem 0.75rem 0.45rem 0;
      border-bottom: 1px solid var(--rule);
      color: var(--ink);
    }

    .cell-set {
      font-weight: 700;
    }

    .cell-peak {
      color: var(--vermilion-text);
      font-weight: 700;
    }
  }
</style>
