---
import ScrollProgress from './ScrollProgress.astro';
import ThemeToggle from './ThemeToggle.astro';

export interface Props {
  title?: string;
  currentWeek?: number;
  currentDay?: number;
}

const { currentWeek, currentDay } = Astro.props;

const brandLabel = currentDay
  ? `Week ${currentWeek ?? Math.ceil(currentDay / 7)} · Day ${currentDay}`
  : currentWeek
    ? `Week ${currentWeek} · 12-Week Hardcore Daily Trainer`
    : '12-Week Hardcore Daily Trainer';

const activeWeekHref = currentWeek ? `/week/${currentWeek}` : '/week/1';
const activeWeekLabel = currentWeek ? `Week ${currentWeek}` : 'Weeks';
---

<header class="app-header">
  <ScrollProgress />
  <div class="header-inner">
    <a href="/" class="brand-btn">
      <svg
        width="22"
        height="22"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.5"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <rect x="2" y="7" width="3" height="10" rx="0.5" />
        <rect x="6" y="5" width="2.5" height="14" rx="0.5" />
        <line x1="8.5" y1="12" x2="15.5" y2="12" />
        <rect x="15.5" y="5" width="2.5" height="14" rx="0.5" />
        <rect x="19" y="7" width="3" height="10" rx="0.5" />
        <circle cx="17" cy="12" r="0.8" fill="var(--vermilion)" stroke="var(--vermilion)" />
      </svg>
      <span class="brand-text">{brandLabel}</span>
    </a>

    <nav class="header-nav" aria-label="Primary">
      <a
        href="/"
        class="nav-link"
        aria-current={!currentWeek && !currentDay ? 'page' : undefined}
      >
        Overview
      </a>
      <a
        href={activeWeekHref}
        class="nav-link"
        aria-current={currentWeek && !currentDay ? 'page' : undefined}
      >
        {activeWeekLabel}
      </a>
      <a
        href="/day/1"
        class="nav-link tabular"
        aria-current={currentDay === 1 ? 'page' : undefined}
      >
        Day 1
      </a>
      <a
        href="/day/54"
        class="nav-link tabular"
        aria-current={currentDay === 54 ? 'page' : undefined}
      >
        Day 54
      </a>
    </nav>

    <div class="header-actions">
      <ThemeToggle />
      <button
        type="button"
        class="icon-hit"
        data-switcher-open
        aria-label="Open Week and Day Quick-Switcher"
        aria-haspopup="dialog"
        aria-controls="quick-switcher"
      >
        <svg
          width="18"
          height="18"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <rect x="3" y="4" width="18" height="16" rx="1" />
          <line x1="3" y1="10" x2="21" y2="10" />
          <line x1="9" y1="4" x2="9" y2="20" />
          <line x1="15" y1="4" x2="15" y2="20" />
        </svg>
      </button>
    </div>
  </div>
</header>
